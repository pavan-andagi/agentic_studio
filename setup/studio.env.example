# Copy to /workspace/studio.env, or (better) enter these as SECRET environment
# variables in your RunPod / Vast.ai template. Never commit real values.
HF_TOKEN=hf_xxx                      # Hugging Face Read token (LTX-2.5 accepted)
ANTHROPIC_API_KEY=sk-ant-xxx         # Claude API key
WITH_4K=0                            # 1 = also install 4K/60fps tools
STUDIO_REPO=your-github-name/agentic_studio   # private repo with this folder
GITHUB_TOKEN=github_pat_xxx          # fine-grained token: read access to that repo
RCLONE_REMOTE=                       # optional, e.g. gdrive:studio
RCLONE_CONFIG_B64=                   # optional: base64 of your rclone.conf
